PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/projectname
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (PDF uploads) — unsigned upload preset from Dashboard → Upload → Upload Presets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Optional: signed download URLs for re-processing PDFs uploaded before inline extraction
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firecrawl (website imports)
FIRECRAWL_API_KEY=

# Inngest (local dev — run `npx inngest-cli@latest dev` alongside the server)
INNGEST_DEV=1
# Production (Inngest Cloud) — set these instead of INNGEST_DEV:
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Production (Inngest Cloud) — set these instead of INNGEST_DEV:
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# OpenAI — gpt-4o-mini for chat, text-embedding-3-small (1536 dims) for Pinecone
OPENAI_API_KEY=

# Pinecone — index is auto-created with 1536 dimensions (cosine) if missing
PINECONE_API_KEY=
PINECONE_INDEX=sourcelab

# Tavily (optional) — chat web-search tool. Without this key the toggle is a no-op.
TAVILY_API_KEY=

# Mem0 (optional) — personal long-term memory. Without this key memory APIs return empty / no-op.
MEM0_API_KEY=

# Resend — verification and password-reset emails. Without these, links are logged to the server console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SourceLab <noreply@example.com>

# Stripe (Better Auth plugin). Without all three, the Stripe plugin is skipped and billing UI cannot checkout.
# STRIPE_PRO_PRICE_ID must be a Price id (price_…), not a Product id (prod_…). Pro is ₹499/month INR.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Optional Postgres pool size (default 5). Keep this low on a 512 MB host.
# PG_POOL_MAX=5

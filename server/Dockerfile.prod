# Build on GitHub Actions — never on the 512 MB EC2 host.
# ---------- Stage 1: compile ----------
FROM node:24-alpine AS builder

WORKDIR /app

RUN apk add --no-cache openssl libc6-compat

COPY package.json package-lock.json .npmrc ./
COPY prisma ./prisma
COPY prisma.config.js ./

RUN npm ci

COPY . .

# prisma generate reads prisma.config.js; no live DB needed
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build"

RUN npx prisma generate && npm run build \
  && mkdir -p dist/generated \
  && cp -R src/generated/. dist/generated/


# ---------- Stage 2: production runtime ----------
FROM node:24-alpine AS production

WORKDIR /app

RUN apk add --no-cache openssl libc6-compat

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=192"
ENV PATH="/app/node_modules/.bin:$PATH"

COPY package.json package-lock.json .npmrc ./
COPY prisma ./prisma
COPY prisma.config.js ./

# prisma is a production dependency so migrate deploy can run at boot
# without npx downloading a second CLI that cannot resolve prisma/config.
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder --chown=node:node /app/dist ./dist

RUN chown -R node:node /app

USER node

EXPOSE 8080

CMD ["sh", "-c", "prisma migrate deploy && exec node dist/index.js"]

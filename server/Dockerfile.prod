# ---------- Stage 1: build ----------
FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY . .

# Assumes a "build" script in package.json (e.g. "tsc") that outputs to ./dist
RUN npm run build


# ---------- Stage 2: production runtime ----------
FROM node:24-alpine AS production

WORKDIR /app

ENV NODE_ENV=production

COPY package.json package-lock.json .npmrc ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

EXPOSE 8080

# Run as non-root
USER node

# Assumes compiled entry point is dist/index.js — adjust if yours differs
CMD ["node", "dist/index.js"]